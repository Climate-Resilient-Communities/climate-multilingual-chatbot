# Secrets and Environment Variables
.env*
*.pem
*.key
*.p12
*.pfx

# Dependencies that cause conflicts
node_modules/
__pycache__/
*.pyc
*.pyo

# Logs that grow large and cause conflicts
*.log
backend.log
frontend.log

# OS generated files that cause conflicts
.DS_Store
Thumbs.db

# IDE/Editor files that cause conflicts
.vscode/settings.json
.idea/
*.swp
*.swo

# Build outputs that should be generated fresh
.next/
out/
dist/
build/
*.tsbuildinfo

# Cache directories that cause deployment issues
.cache/
.pytest_cache/

# Development-only folders that shouldn't be deployed
.cursor/
.history/
.logs/
.claude/
dump.rdb
*.aof
appendonlydir/

# Test output artifacts (regenerated by tests/unit/test_rag_verification*.py)
rag_test_results.json
rexdale_rag_test_results.json

# Large source documents are ingested locally (scripts/rag_ingest.py --collection ...)
# and must never be committed - GitHub rejects files over 100MB anyway.
data/rag_docs/**/*.pdf
